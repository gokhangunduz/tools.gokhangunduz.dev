#!/usr/bin/env node
'use strict'

/*
 * harness — the one tool that turns `harness/` into every vendor's format,
 * and that keeps a task from drifting while it is being done.
 *
 *   harness sync [--check]   generate (or verify) every vendor target
 *   harness scope <intent> <path...>   declare what this task may touch
 *   harness note <defect> <file:line> ...   file a finding, keep working
 *   harness done             clear the declared scope
 *   harness labels           create or update the canonical labels on the remote
 *   harness install-hooks    install the commit-msg and pre-commit gates
 *   harness doctor           check the local toolchain
 *
 * Adapted from the harnesswift template for a Next.js static-export site.
 */

const fs = require('fs')
const path = require('path')
const { execFileSync } = require('child_process')
const crypto = require('node:crypto')

const ROOT = path.resolve(__dirname, '..')
const p = (...s) => path.join(ROOT, ...s)
const read = (f) => fs.readFileSync(p(f), 'utf8')
const exists = (f) => fs.existsSync(p(f))

const manifest = JSON.parse(read('harness/manifest.json'))
const { project, roles } = manifest

const os = require('os')

const RED = '\x1b[31m', GREEN = '\x1b[32m', YELLOW = '\x1b[33m', DIM = '\x1b[2m', OFF = '\x1b[0m'
const die = (msg) => { console.error(`${RED}✗${OFF} ${msg}`); process.exit(1) }
const ok = (msg) => console.log(`${GREEN}✓${OFF} ${msg}`)
const info = (msg) => console.log(`${DIM}${msg}${OFF}`)

/* ---------------------------------------------------------------- helpers */

const banner = (src) =>
  `<!-- GENERATED from ${src} by \`bin/harness sync\` — do not edit this file. -->`

// Split `---\nfrontmatter\n---\nbody` into its parts. Skills carry their own
// frontmatter so they stay portable; roles take theirs from the manifest.
function splitFrontmatter (text) {
  const m = /^---\n([\s\S]*?)\n---\n?/.exec(text)
  return m ? { fm: m[1], body: text.slice(m[0].length).trimStart() } : { fm: null, body: text }
}

function fmValue (fm, key) {
  const m = new RegExp(`^${key}:\\s*(.+)$`, 'm').exec(fm || '')
  return m ? m[1].trim().replace(/^["']|["']$/g, '') : null
}

const yamlString = (s) => `"${String(s).replace(/\\/g, '\\\\').replace(/"/g, '\\"')}"`

function walk (dir, base = dir, out = []) {
  if (!fs.existsSync(dir)) return out
  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
    const full = path.join(dir, entry.name)
    if (entry.isDirectory()) walk(full, base, out)
    else out.push(path.relative(base, full))
  }
  return out
}

function git (args, opts = {}) {
  return execFileSync('git', args, { cwd: ROOT, encoding: 'utf8', ...opts }).trim()
}

function tryGit (args) {
  try { return git(args, { stdio: ['pipe', 'pipe', 'pipe'] }) } catch { return null }
}

/* ------------------------------------------------------- the Next.js block */

// `next dev` upserts a managed block into AGENTS.md whenever it is missing or
// differs from the one the installed version writes. Emitting that exact block
// here keeps `next dev` from ever touching the generated file. The block is
// taken from the installed package by letting it scaffold a scratch directory,
// so it follows a Next.js upgrade instead of being copied by hand; without
// node_modules, the block already in AGENTS.md is kept as it is.
const NEXT_START = '<!-- BEGIN:nextjs-agent-rules -->'
const NEXT_END = '<!-- END:nextjs-agent-rules -->'

function nextAgentBlock () {
  const lib = p('node_modules/next/dist/server/lib/generate-agent-files.js')
  if (fs.existsSync(lib)) {
    const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'harness-next-'))
    try {
      require(lib).writeAgentFiles(dir)
      const text = fs.readFileSync(path.join(dir, 'AGENTS.md'), 'utf8')
      const start = text.indexOf(NEXT_START)
      const end = text.indexOf(NEXT_END)
      if (start !== -1 && end > start) return text.slice(start, end + NEXT_END.length)
    } catch {
      // fall through to the block already on disk
    } finally {
      fs.rmSync(dir, { recursive: true, force: true })
    }
  }
  const current = exists('AGENTS.md') ? read('AGENTS.md') : ''
  const start = current.indexOf(NEXT_START)
  const end = current.indexOf(NEXT_END)
  return start !== -1 && end > start ? current.slice(start, end + NEXT_END.length) : null
}

/* --------------------------------------------------------------- generate */

// Every generated artefact, as a path → content map. Nothing is written until
// the whole map is built, so `--check` and `sync` can never disagree.
function generate () {
  const out = new Map()
  const contract = read('harness/contract.md').trim()

  // Every role in the manifest needs a brief and a skill. Saying which one is
  // missing costs one loop; finding out from a stack trace costs ten minutes.
  for (const role of roles) {
    if (!exists(`harness/roles/${role.name}.md`)) {
      die(`harness/manifest.json declares role "${role.name}" but harness/roles/${role.name}.md does not exist`)
    }
    if (!exists(`harness/skills/${role.skill}/SKILL.md`)) {
      die(`role "${role.name}" names skill "${role.skill}" but harness/skills/${role.skill}/SKILL.md does not exist`)
    }
  }
  const skillNames = fs.readdirSync(p('harness/skills')).filter((d) =>
    fs.existsSync(p('harness/skills', d, 'SKILL.md')))
  const commandNames = (manifest.commands || []).filter((c) =>
    exists(`harness/commands/${c}.md`))

  const skillMeta = {}
  for (const name of skillNames) {
    const { fm, body } = splitFrontmatter(read(`harness/skills/${name}/SKILL.md`))
    skillMeta[name] = {
      description: fmValue(fm, 'description') || '',
      fm,
      body,
      files: walk(p('harness/skills', name)).filter((f) => f !== 'SKILL.md')
    }
  }

  /* ---- the universal contract: AGENTS.md ---- */
  const projectFacts = [
    '## This project',
    '',
    `| | |`,
    `|---|---|`,
    `| Site | **${project.displayName}** — ${project.url} |`,
    `| Stack | ${project.stack.join(' · ')} |`,
    `| Localized | ${project.languages.map((l) => l.toUpperCase()).join(' · ')} — default ${project.defaultLanguage.toUpperCase()} |`,
    `| Node | ${project.node} |`,
    `| Hosting | ${project.hosting} |`,
    ''
  ].join('\n')

  const nextBlock = nextAgentBlock()
  out.set('AGENTS.md', [
    ...(nextBlock ? [nextBlock, ''] : []),
    `# ${project.displayName} — agent guide`,
    '',
    banner('harness/contract.md + harness/manifest.json'),
    '',
    '> This is the working contract every agent reads, whatever tool it runs in.',
    "> Tool-specific files (`CLAUDE.md`, `.cursor/rules/`, `GEMINI.md`, `.github/copilot-instructions.md`)",
    '> are thin pointers to this one. Edit `harness/contract.md`, then run `bin/harness sync`.',
    '',
    projectFacts,
    '---',
    '',
    contract,
    '',
    '---',
    '',
    '## Specialist briefs',
    '',
    'Each specialist has a full brief and a skill. Read the brief before acting in that role.',
    '',
    '| Specialist | Reasoning | Owns |',
    '|---|---|---|',
    // `owns` rather than `description`: the description is written for a tool
    // deciding which agent to route to, and it is three times as long as anyone
    // reading a table wants. It is already in the agent frontmatter, where it
    // does that job.
    ...roles.map((r) =>
      `| \`${r.name}\` | ${r.reasoning || '—'} | ${r.owns || r.description} |`),
    '',
    'Each has a brief in `harness/roles/` and a skill in `harness/skills/`. The',
    'reasoning tier says how much judgment the role needs: **high** for work where',
    'being wrong is expensive or the answer does not decompose into rules,',
    '**standard** for a known pipeline, **fast** for mechanical work. Tools that',
    'can pick a model should pick one to match; tools that cannot should know how',
    'hard the role is expected to be.',
    ''
  ].join('\n'))

  /* ---- thin pointers ---- */
  // `imports` is a line the tool expands into the file's content in place, for
  // tools that support it — so the contract is loaded, not merely pointed at.
  const pointer = (tool, imports) => [
    `# ${project.displayName}`,
    '',
    banner('harness/manifest.json'),
    '',
    `**Read [\`AGENTS.md\`](AGENTS.md).** It is the single working contract for this repository —`,
    'scope discipline, the verification ladder, the invariants, and the commit convention.',
    `This file exists only because ${tool} looks for it by name; it deliberately holds no rules of its own.`,
    '',
    'Specialist briefs live in `harness/roles/`, their skills in `harness/skills/`.',
    ...(imports ? ['', imports] : []),
    ''
  ].join('\n')

  if (manifest.targets['claude-code'].enabled) out.set('CLAUDE.md', pointer('Claude Code', '@AGENTS.md'))
  if (manifest.targets.gemini.enabled) out.set('GEMINI.md', pointer('the Gemini CLI'))
  if (manifest.targets.copilot.enabled) {
    out.set('.github/copilot-instructions.md', [
      banner('harness/manifest.json'),
      '',
      `# ${project.displayName}`,
      '',
      'Read `AGENTS.md` at the repository root before proposing any change. It is the',
      'single working contract: scope discipline, the verification ladder, the invariants',
      'and the commit convention. The rules below are its short form.',
      '',
      '- Do one declared task. Log anything else you notice instead of fixing it.',
      '- Never report work as done without running the matching script under `verify/`.',
      '- Nothing the visitor types leaves the browser: no API route, server action, proxy or third-party script. A tool that calls an API sets `network: true`.',
      '- Every visible string exists in Turkish and English: `t(locale, key)` for the shell, a `Localized` `{ tr, en }` in the tool.',
      '- Colours come from the tokens in `src/app/globals.css`; never a hex value in a component.',
      '- A tool\'s work is a pure function in `logic.ts` with a vitest `logic.test.ts`; user errors are `ToolError` in both languages.',
      '- Commits are `<type>(<scope>): <emoji> <subject>` and never carry an AI co-author trailer.',
      ''
    ].join('\n'))
  }

  /* ---- Claude Code ---- */
  const claudeSkill = (name, prefix) => {
    const s = skillMeta[name]
    return [
      '---',
      `name: ${name}`,
      `description: ${yamlString(s.description)}`,
      '---',
      '',
      banner(`harness/skills/${name}/SKILL.md`),
      '',
      s.body.trim(),
      ''
    ].join('\n')
  }

  const claudeAgent = (r) => [
    '---',
    `name: ${r.name}`,
    `description: ${yamlString(r.description)}`,
    ...(r.claude && r.claude.tools ? [`tools: ${r.claude.tools}`] : []),
    ...(r.claude && r.claude.model ? [`model: ${r.claude.model}`] : []),
    '---',
    '',
    banner(`harness/roles/${r.name}.md`),
    '',
    read(`harness/roles/${r.name}.md`).trim(),
    '',
    `Load the \`${r.skill}\` skill for the detail behind these instructions, and`,
    'follow `AGENTS.md` — it applies to you as much as to the main session.',
    ''
  ].join('\n')

  const commandFile = (name) => {
    const { fm, body } = splitFrontmatter(read(`harness/commands/${name}.md`))
    return ['---', fm, '---', '', banner(`harness/commands/${name}.md`), '', body.trim(), ''].join('\n')
  }

  const emit = (prefix) => {
    for (const name of skillNames) {
      out.set(`${prefix}/skills/${name}/SKILL.md`, claudeSkill(name, prefix))
      for (const f of skillMeta[name].files) {
        out.set(`${prefix}/skills/${name}/${f}`, read(`harness/skills/${name}/${f}`))
      }
    }
    for (const r of roles) out.set(`${prefix}/agents/${r.name}.md`, claudeAgent(r))
    for (const c of commandNames) out.set(`${prefix}/commands/${c}.md`, commandFile(c))
  }

  if (manifest.targets['claude-code'].enabled) {
    emit('.claude')
    // The scope gate, as a hook: a rule the model can forget becomes a message
    // it cannot. It warns and never blocks — verify/scope.sh is the real gate.
    const hook = (name) => ({ type: 'command', command: `"$CLAUDE_PROJECT_DIR"/bin/harness ${name}` })
    const settings = manifest.targets['claude-code']
    out.set('.claude/settings.json', JSON.stringify({
      $schema: 'https://json.schemastore.org/claude-code-settings.json',
      ...(settings.permissions ? { permissions: settings.permissions } : {}),
      hooks: {
        // What the model cannot see, and what it must not do. Each entry exists
        // because a rule in the contract alone was not enough.
        SessionStart: [{ hooks: [hook('session-start')] }],
        PreToolUse: [
          { matcher: 'Bash', hooks: [hook('pre-bash')] },
          // Generated files are build artefacts: an edit there is silently
          // overwritten by the next sync, so it is refused at the tool call.
          { matcher: 'Edit|Write|MultiEdit|NotebookEdit', hooks: [hook('pre-edit')] }
        ],
        PostToolUse: [{
          matcher: 'Edit|Write|MultiEdit|NotebookEdit',
          hooks: [hook('post-edit')]
        }],
        // Before the context is compacted, the task state is written down —
        // scope, dirty files, last verify — so nothing is lost to a summary.
        PreCompact: [{ hooks: [hook('pre-compact')] }],
        // Session ending is the other way the context is lost — save the state
        // if there is unfinished work, so a crashed or closed session resumes.
        SessionEnd: [{ hooks: [hook('session-end')] }],
        Stop: [{ hooks: [hook('stop')] }]
      }
    }, null, 2) + '\n')
  }

  /* ---- Cursor ---- */
  if (manifest.targets.cursor.enabled) {
    out.set('.cursor/rules/00-contract.mdc', [
      '---',
      `description: ${yamlString('The working contract for this repository — always in force.')}`,
      'globs:',
      'alwaysApply: true',
      '---',
      '',
      banner('harness/contract.md'),
      '',
      contract,
      ''
    ].join('\n'))

    roles.forEach((r, i) => {
      const globs = (r.globs || []).length ? (r.globs || []).join(',') : ''
      out.set(`.cursor/rules/${String(10 + i * 10)}-${r.name}.mdc`, [
        '---',
        `description: ${yamlString(r.description)}`,
        `globs: ${globs}`,
        `alwaysApply: false`,
        '---',
        '',
        banner(`harness/roles/${r.name}.md`),
        '',
        read(`harness/roles/${r.name}.md`).trim(),
        '',
        `The full skill for this role is \`harness/skills/${r.skill}/SKILL.md\`.`,
        ''
      ].join('\n'))
    })
  }

  /* ---- GitHub issue templates ---- */
  for (const f of walk(p('harness/github/ISSUE_TEMPLATE'))) {
    out.set(`.github/ISSUE_TEMPLATE/${f}`, read(`harness/github/ISSUE_TEMPLATE/${f}`))
  }

  return out
}

/* ------------------------------------------------------------------- sync */

function cmdSync (argv) {
  const check = argv.includes('--check')
  const generated = generate()
  const drift = []

  for (const [rel, content] of generated) {
    const current = exists(rel) ? read(rel) : null
    if (current !== content) drift.push(rel)
  }

  // A generated file whose source disappeared is drift too. Every directory
  // that holds generated files is walked, so a renamed or orphaned one is
  // caught. The `.claude` root itself is read one level deep only: below it
  // live worktrees and other runtime state that sync must never touch.
  const managedRoots = ['.claude/skills', '.claude/agents', '.claude/commands',
    '.cursor/rules', '.github/ISSUE_TEMPLATE']
  // Files directly under .claude/ that are deliberately NOT generated: a
  // per-machine settings override, the preview launcher, and runtime state (a
  // scheduler lock) — which sync must neither flag as an orphan nor delete out
  // from under a running session.
  const ORPHAN_KEEP = new Set(['.claude/settings.local.json', '.claude/launch.json', '.claude/scheduled_tasks.lock'])
  const stale = []
  const seenStale = new Set()
  const shallow = fs.existsSync(p('.claude'))
    ? fs.readdirSync(p('.claude'), { withFileTypes: true }).filter((e) => e.isFile()).map((e) => e.name)
    : []
  for (const [root, files] of [['.claude', shallow], ...managedRoots.map((r) => [r, walk(p(r))])]) {
    for (const f of files) {
      const rel = `${root}/${f}`
      if (generated.has(rel) || ORPHAN_KEEP.has(rel) || seenStale.has(rel)) continue
      seenStale.add(rel)
      stale.push(rel)
    }
  }

  if (check) {
    if (!drift.length && !stale.length) return ok('generated files are in sync with harness/')
    for (const f of drift) console.error(`${YELLOW}stale${OFF}  ${f}`)
    for (const f of stale) console.error(`${YELLOW}orphan${OFF} ${f}`)
    die(`${drift.length + stale.length} file(s) out of sync — run \`bin/harness sync\` and commit the result`)
  }

  for (const [rel, content] of generated) {
    fs.mkdirSync(path.dirname(p(rel)), { recursive: true })
    fs.writeFileSync(p(rel), content)
  }
  for (const f of stale) fs.rmSync(p(f))

  ok(`wrote ${generated.size} file(s)` + (stale.length ? `, removed ${stale.length} orphan(s)` : ''))
  info(`   targets: ${Object.entries(manifest.targets).filter(([, v]) => v.enabled).map(([k]) => k).join(', ')}`)
}

/* ------------------------------------------------------------------ scope */

const SCOPE_FILE = '.harness/scope.json'

function loadScope () {
  return exists(SCOPE_FILE) ? JSON.parse(read(SCOPE_FILE)) : null
}

function cmdScope (argv) {
  if (argv[0] === '--show' || argv.length === 0) {
    const s = loadScope()
    if (!s) return info('no scope declared — the gate is inert')
    console.log(`intent: ${s.intent}`)
    console.log(`paths:  ${s.paths.join(', ')}`)
    console.log(`since:  ${s.declaredAt}`)
    return
  }
  const [intent, ...paths] = argv
  if (!paths.length) die('declare at least one path: bin/harness scope "<intent>" <path>...')
  for (const q of paths) {
    if (!fs.existsSync(p(q))) console.error(`${YELLOW}!${OFF} ${q} does not exist yet — allowed anyway`)
  }
  fs.mkdirSync(p('.harness'), { recursive: true })
  fs.writeFileSync(p(SCOPE_FILE), JSON.stringify({
    intent,
    paths,
    declaredAt: new Date().toISOString(),
    baseCommit: tryGit(['rev-parse', 'HEAD']) || null
  }, null, 2) + '\n')
  ok(`scope: ${intent}`)
  info(`   may touch: ${paths.join(', ')}`)
  info('   anything else → bin/harness note "<defect>" <file>:<line> …')
}

function cmdDone () {
  if (!exists(SCOPE_FILE)) return info('no scope was declared')
  const s = loadScope()
  fs.rmSync(p(SCOPE_FILE))
  ok(`scope closed: ${s.intent}`)
}

/* ------------------------------------------------------------------ hooks */

// Hooks are the part of this harness that does not depend on anyone
// remembering. A rule in the contract persuades; a hook is a gate. Each one
// below is deliberately narrow — it reports a fact the model cannot see, or it
// refuses one of the few actions that quietly undo the conventions.

const readStdin = () => new Promise((resolve) => {
  let raw = ''
  process.stdin.setEncoding('utf8')
  process.stdin.on('data', (d) => { raw += d })
  process.stdin.on('end', () => { try { resolve(JSON.parse(raw)) } catch { resolve({}) } })
})

const relativeToRoot = (file) => {
  if (!file) return null
  // Resolve against ROOT first: the tool may hand us a path relative to the
  // working directory, and path.relative on a bare relative path is nonsense.
  const rel = path.relative(ROOT, path.resolve(ROOT, file))
  return rel.startsWith('..') ? null : rel
}

// True when the task is scoped to harness/ itself. Editing there runs the
// post-edit auto-sync, which rewrites ~60 vendor files in .claude/, .github/,
// .cursor/ and the root — none of them under a harness/ path. They are the
// build output of an in-scope edit, so they must count as in scope too, or the
// sync self-trips the scope warning, the Stop gate and the git-add guard.
const scopeCoversHarness = (scope) =>
  scope.paths.some((path) => path === 'harness' || path.replace(/\/$/, '') === 'harness' || path.startsWith('harness/'))

const inScope = (rel, scope) => {
  const allowed = [...scope.paths, '.harness/', 'FINDINGS.md']
  if (scopeCoversHarness(scope)) allowed.push(...GENERATED_PREFIXES)
  return allowed.some((entry) => {
    const base = entry.replace(/\/$/, '')
    return rel === base || rel.startsWith(base + '/')
  })
}

// Deliberately untrimmed. `git status --porcelain` encodes the status in the
// first two columns, so the leading space of an unstaged change is data — trim
// it and every path shifts by one character, turning ".claude/settings.json"
// into "claude/settings.json" and silently breaking every scope comparison.
const quietly = (command, args) => {
  try {
    return execFileSync(command, args, { cwd: ROOT, encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'], timeout: 5000 })
  } catch { return null }
}

const quietlyValue = (command, args) => {
  const out = quietly(command, args)
  return out === null ? null : out.trim()
}

/** The paths in `git status --porcelain`, with the status columns removed. */
const changedFiles = () => (quietly('git', ['status', '--porcelain']) || '')
  .split('\n')
  .filter(Boolean)
  .map((line) => line.slice(3))
  // A rename reads "old -> new"; the new path is the one that exists.
  .map((file) => file.includes(' -> ') ? file.split(' -> ')[1] : file)
  .map((file) => file.replace(/^"|"$/g, ''))
  .filter(Boolean)

/* --- after an edit: scope warning, and keep the generated files in step --- */

async function cmdPostEdit () {
  const input = await readStdin()
  const rel = relativeToRoot(input?.tool_input?.file_path)
  if (!rel) return process.exit(0)

  // A PostToolUse hook's stdout goes to the transcript, not to the model. The
  // only channel that reaches it is hookSpecificOutput.additionalContext — so
  // every notice is collected here and emitted once, as that, at the end.
  const notes = []

  // A change under harness/ has generated counterparts in six other places.
  // Regenerating here means they can never be stale for longer than one edit,
  // and `verify/harness.sh` stops being a trap you spring on yourself.
  if (rel.startsWith('harness/')) {
    try {
      execFileSync(p('bin/harness'), ['sync'], { cwd: ROOT, stdio: ['ignore', 'pipe', 'pipe'] })
      notes.push(`Regenerated the vendor files from ${rel}. Commit them with the source.`)
    } catch {
      notes.push(`${rel} changed but \`bin/harness sync\` failed — run it and read the error.`)
    }
  }

  // Formatting drift surfaces at the edit, not at the commit: one file, one
  // prettier check, a few hundred milliseconds. A warning, never a block —
  // verify/lint.sh is the gate.
  if (/^src\/.*\.(ts|tsx|json|css)$/.test(rel) && exists(rel)) {
    const prettier = p('node_modules/.bin/prettier')
    if (!fs.existsSync(prettier)) {
      notes.push(`prettier is not installed (npm install), so ${rel} was not checked for formatting drift.`)
    } else if (quietly(prettier, ['--check', p(rel)]) === null) {
      notes.push(`prettier: ${rel} has formatting drift — verify/lint.sh will fail. Fix now: npx prettier --write ${rel}`)
    }
  }

  const scope = loadScope()
  if (scope && !inScope(rel, scope)) {
    notes.push(
      `Scope warning: ${rel} is outside "${scope.intent}".\n` +
      `Allowed: ${scope.paths.join(', ')}\n` +
      'If it belongs to the task, widen it with `bin/harness scope`.\n' +
      'If it is something you noticed, revert it, reproduce it, and file it with `bin/harness note`.\n' +
      'verify/scope.sh will refuse to certify this diff otherwise.')
  }

  if (notes.length) {
    console.log(JSON.stringify({
      hookSpecificOutput: {
        hookEventName: 'PostToolUse',
        additionalContext: notes.join('\n\n')
      }
    }))
  }
  process.exit(0)
}

/* --- before an edit: the files no hand may touch --- */

// Paths produced by `bin/harness sync`. Editing one directly is editing a
// build artefact: the change survives until the next sync and then vanishes
// without a trace — worse than an error.
const GENERATED_PREFIXES = [
  'AGENTS.md', 'CLAUDE.md', 'GEMINI.md',
  '.claude/settings.json', '.claude/skills/', '.claude/agents/', '.claude/commands/',
  '.cursor/rules/',
  '.github/copilot-instructions.md', '.github/ISSUE_TEMPLATE/'
]

// Build output of `next build`: rewritten on every build, never committed.
const BUILD_OUTPUT_PREFIXES = ['out/', '.next/']

// Files that live under a generated prefix but are written by hand, not by
// sync. They are exceptions to the refusal below.
const HAND_AUTHORED = new Set([])

async function cmdPreEdit () {
  const input = await readStdin()
  const rel = relativeToRoot(input?.tool_input?.file_path)
  if (!rel) return process.exit(0)

  if (BUILD_OUTPUT_PREFIXES.some((prefix) => rel.startsWith(prefix))) {
    console.error(`Refused: ${rel} is build output of \`next build\` and is rewritten on every build.`)
    console.error('Change the source under src/ or public/ and rebuild: zsh verify/build.sh')
    process.exit(2)
  }

  // Case-insensitive: APFS is case-insensitive by default, so a match on the
  // path as typed would miss `.CLAUDE/` or `Agents.md` while the file it names
  // is still generated.
  const relLower = rel.toLowerCase()
  const hit = !HAND_AUTHORED.has(relLower) && GENERATED_PREFIXES.find((prefix) => {
    const pl = prefix.toLowerCase()
    return pl.endsWith('/') ? relLower.startsWith(pl) : relLower === pl
  })
  if (hit) {
    console.error(`Refused: ${rel} is GENERATED from harness/ — an edit here is overwritten by the next 'bin/harness sync'.`)
    console.error('Edit the source under harness/ instead; the post-edit hook regenerates every target.')
    process.exit(2)
  }
  process.exit(0)
}

/* --- before compaction: write the task state down --- */

// The state worth writing down when the context is about to be lost — to a
// compaction or to the session ending. A distinct path from the hand-written
// /handoff note (.harness/handoff.md): both fire without warning, and
// clobbering a note someone wrote on purpose with an auto stub loses the more
// valuable of the two.
function writeAutoHandoff (header) {
  const scope = loadScope()
  const dirty = changedFiles()
  let stamp = null
  try { stamp = exists(VERIFY_STAMP) ? JSON.parse(read(VERIFY_STAMP)) : null } catch { stamp = null }

  const lines = [
    `# Handoff (${header})`,
    '',
    scope ? `Scope:    "${scope.intent}" — may touch: ${scope.paths.join(', ')}` : 'Scope:    none declared',
    `Branch:   ${quietlyValue('git', ['rev-parse', '--abbrev-ref', 'HEAD']) || '?'} @ ${quietlyValue('git', ['rev-parse', '--short', 'HEAD']) || '?'}`,
    dirty.length ? `Dirty:    ${dirty.length} file(s): ${dirty.slice(0, 8).join(', ')}` : 'Dirty:    nothing — tree clean',
    stamp ? `Verified: rungs [${(stamp.rungs || []).join(', ')}] on fingerprint ${stamp.fingerprint}` : 'Verified: no ladder stamp on this tree',
    '',
    'Pick up: finish the scope above, run the matching rungs, then `bin/harness done`.',
    ''
  ]
  fs.mkdirSync(p('.harness'), { recursive: true })
  fs.writeFileSync(p('.harness/handoff-auto.md'), lines.join('\n'))
}

async function cmdPreCompact () {
  await readStdin()
  // Always: the whole point is that the context is about to be summarised away.
  writeAutoHandoff('written automatically before compaction')
  process.exit(0)
}

async function cmdSessionEnd () {
  await readStdin()
  // Only when there is unfinished work to resume — an open scope or a dirty
  // tree. A clean session that ends leaves no stub for the next one to puzzle
  // over. Never overwrites the compaction handoff with "nothing to do".
  if (loadScope() || changedFiles().length) {
    writeAutoHandoff('written automatically at session end')
  }
  process.exit(0)
}

/* --- at session start: what is already in flight --- */

async function cmdSessionStart () {
  const lines = []

  const scope = loadScope()
  if (scope) {
    lines.push(`Scope declared: "${scope.intent}"`)
    lines.push(`  may touch: ${scope.paths.join(', ')}`)
    lines.push('  Work inside it. Anything else you find: reproduce it, `bin/harness note` it, carry on.')
  }

  // A handoff written by /handoff yesterday is exactly what today needs first;
  // the auto-saved stub from the last compaction is second. Surface whichever
  // exists, hand-written before auto, without touching either.
  for (const [file, label] of [
    ['.harness/handoff.md', 'Handoff from the previous session (hand-written, .harness/handoff.md):'],
    ['.harness/handoff-auto.md', 'Auto-saved state from before the last compaction (.harness/handoff-auto.md):']
  ]) {
    if (exists(file)) {
      lines.push(label)
      lines.push(read(file).trim())
      lines.push(`  Delete once picked up: rm ${file}`)
    }
  }

  const branch = quietlyValue('git', ['rev-parse', '--abbrev-ref', 'HEAD'])
  const dirty = changedFiles()
  if (branch) lines.push(`Branch: ${branch}${dirty.length ? ` — ${dirty.length} file(s) changed and uncommitted` : ' — clean'}`)

  const stale = []
  if (quietlyValue(p('bin/harness'), ['sync', '--check']) === null) stale.push('generated agent files (bin/harness sync)')
  if (stale.length) lines.push(`Stale, regenerate before committing: ${stale.join(', ')}`)

  // Findings are the queue that scope discipline creates. Surfacing them here is
  // what stops them becoming a list nobody opens.
  const findings = quietlyValue('gh', ['issue', 'list', '--label', 'agent-finding',
    '--state', 'open', '--limit', '5', '--json', 'number,title',
    '--jq', '.[] | "  #\\(.number) \\(.title)"'])
  if (findings) {
    lines.push('Open findings from earlier tasks:')
    lines.push(findings)
    lines.push('  These are already triaged out of the current task. Do not pick one up unasked.')
  }

  if (lines.length) {
    console.log('## Harness state\n')
    console.log(lines.join('\n'))
  }
  process.exit(0)
}

/* --- before a shell command: the few actions that undo the conventions --- */

const FORBIDDEN_COMMANDS = [
  {
    // `stripStrings` first removes every quoted substring, so `-n` and
    // `--no-verify` inside a commit message body — `git commit -m "handle -n"`
    // — are gone before the match, and only an actual FLAG can trip it. The
    // `[^\n|;&]*` bound keeps it from reaching across a pipe or `;` into a
    // `grep -n` that merely mentions the flag. The second alternative catches
    // `git -c core.hooksPath=… commit`, which disables the commit-msg hook
    // just as surely as `--no-verify` does.
    stripStrings: true,
    pattern: /\bgit\s[^\n|;&]*\bcommit\b[^\n|;&]*(--no-verify\b|\s-n\b)|\bgit\s[^\n|;&]*-c\s+core\.hooksPath\b[^\n|;&]*\bcommit\b/,
    why: 'That skips the commit-msg and pre-commit hooks, which enforce the commit convention, the ban on AI attribution trailers and the quick rungs.',
    instead: 'Fix the message so it passes: `<type>(<scope>): <emoji> <subject>`, imperative, under 72 characters.'
  },
  {
    // stripStrings: a real force push is never inside quotes, so removing
    // quoted substrings first kills the false positive on `echo "… --force"`
    // and a doc line mentioning the flag, without missing an actual one.
    stripStrings: true,
    pattern: /git\s+push\b[^\n]*(--force(?!-with-lease)|(?:^|\s)-f(?:\s|$))/,
    why: 'A force push rewrites history other people and other machines may already have.',
    instead: 'Use --force-with-lease if you genuinely must, and say why first.'
  },
  {
    // Covers v* and build/* tags, quoted forms (`-d 'v1.0.0'`), full refs
    // (`refs/tags/v1.0.0`) and the colon-refspec delete (`push origin :v1.0.0`).
    // Deliberately NOT stripStrings: this rule reads the quote characters to
    // catch a quoted tag name, and stripping them would turn `-d 'v1.0.0'` into
    // a miss. Over-blocking a doc line that quotes a tag deletion is friction;
    // missing a real irreversible deletion is data loss — so it errs to block.
    pattern: /git\s+tag\s+(-d|--delete)\s+['"]?(refs\/tags\/)?(v\d|build\/)|git\s+push\b[^\n]*(--delete[^\n]*\b(v\d|build\/)|:\s*['"]?(refs\/tags\/)?(v\d|build\/))/,
    why: 'A `v` tag records that a version was live; a `build/*` tag records which commit produced a deploy. Both stay true whatever happened afterwards, and someone may already have cited them.',
    instead: 'Leave it. Tag a new version with what changed instead.'
  }
]

// Remove every quoted substring so a flag named inside a commit message body or
// an echo argument cannot be mistaken for the flag itself.
const stripQuoted = (s) => s.replace(/'[^']*'/g, '').replace(/"(?:[^"\\]|\\.)*"/g, '')

async function cmdPreBash () {
  const input = await readStdin()
  const command = input?.tool_input?.command
  if (typeof command !== 'string') return process.exit(0)

  for (const rule of FORBIDDEN_COMMANDS) {
    const target = rule.stripStrings ? stripQuoted(command) : command
    if (rule.pattern.test(target)) {
      console.error(`Refused: ${command}`)
      console.error(rule.why)
      console.error(rule.instead)
      process.exit(2)
    }
  }

  // `git add -A` is fine on a tree you created. It is not fine when a scope is
  // declared and the tree already holds changes outside it — that is how an
  // unrelated file rides along into a commit nobody reviewed.
  if (/git\s+add\s+(-A\b|--all\b|\.(?:\s|$))/.test(command)) {
    const scope = loadScope()
    if (scope) {
      const outside = changedFiles().filter((file) => !inScope(file, scope))
      if (outside.length) {
        console.error(`Refused: staging everything would include ${outside.length} file(s) outside the scope "${scope.intent}":`)
        for (const file of outside.slice(0, 10)) console.error(`  ${file}`)
        console.error('Stage the files this task changed by name, or widen the scope deliberately with `bin/harness scope`.')
        process.exit(2)
      }
    }
  }

  process.exit(0)
}

/* --- at the end of a turn: did this actually get finished? --- */

const VERIFY_STAMP = '.harness/last-verify.json'

// A hash of what the working tree looks like right now. The ladder records it
// when it passes; the Stop hook compares. That is the difference between
// "the ladder ran at some point" and "the ladder ran on *this* code".
function treeFingerprint () {
  const status = quietly('git', ['status', '--porcelain']) || ''
  const head = quietlyValue('git', ['rev-parse', 'HEAD']) || ''
  return crypto.createHash('sha256').update(head + '\n' + status).digest('hex').slice(0, 16)
}

function cmdStampVerify () {
  fs.mkdirSync(p('.harness'), { recursive: true })
  fs.writeFileSync(p(VERIFY_STAMP), JSON.stringify({
    fingerprint: treeFingerprint(),
    rungs: process.argv.slice(3)
  }, null, 2) + '\n')
}

async function cmdStop () {
  const input = await readStdin()
  // The hook fires again after it blocks. Blocking twice on the same turn is a
  // loop, not a gate.
  if (input?.stop_hook_active) return process.exit(0)

  const dirty = changedFiles()
  if (!dirty.length) return process.exit(0)

  const problems = []

  const stamp = exists(VERIFY_STAMP) ? JSON.parse(read(VERIFY_STAMP)) : null
  if (!stamp || stamp.fingerprint !== treeFingerprint()) {
    problems.push(
      `${dirty.length} file(s) changed and the ladder has not run on them. ` +
      'Run `zsh verify/all.sh` (or the rungs that cover what you touched) before saying it is done.')
  }

  const scope = loadScope()
  if (scope) {
    const outside = dirty.filter((file) => !inScope(file, scope))
    if (outside.length) {
      problems.push(
        `${outside.length} file(s) are outside the declared scope "${scope.intent}": ${outside.slice(0, 5).join(', ')}. ` +
        'Either widen the scope deliberately, or revert them and file what you found.')
    } else {
      problems.push(
        `The scope "${scope.intent}" is still open. If the task is finished, run \`bin/harness done\`. ` +
        'If it is not, say what is left.')
    }
  }

  if (!problems.length) return process.exit(0)

  console.log(JSON.stringify({
    decision: 'block',
    reason: 'Before finishing:\n\n' + problems.map((p) => `- ${p}`).join('\n') +
      '\n\nIf one of these is deliberate, say so plainly in your reply rather than working around it.'
  }))
  process.exit(0)
}

/* ------------------------------------------------------------------- note */

const AREAS = ['tools', 'shell', 'i18n', 'design', 'a11y', 'perf', 'privacy', 'tests',
  'harness', 'build', 'ci', 'deploy', 'docs']
const TYPES = ['feat', 'fix', 'docs', 'style', 'refactor', 'test', 'chore', 'release']
const PRIORITIES = { P0: 'P0 critical', P1: 'P1 high', P2: 'P2 normal', P3: 'P3 low' }

function parseFlags (argv) {
  const flags = {}, positional = []
  for (let i = 0; i < argv.length; i++) {
    if (argv[i].startsWith('--')) flags[argv[i].slice(2)] = argv[++i]
    else positional.push(argv[i])
  }
  return { flags, positional }
}

function cmdNote (argv) {
  const { flags, positional } = parseFlags(argv)
  const [defect, location] = positional

  const missing = []
  if (!defect) missing.push('<defect> (one sentence, positional)')
  if (!location || !/^[^\s:]+:\d+$/.test(location || '')) missing.push('<file>:<line> (positional)')
  if (!flags.type) missing.push('--type ' + TYPES.join('|'))
  if (!flags.area) missing.push('--area ' + AREAS.join('|'))
  if (!flags.failure) missing.push('--failure "<state → path → wrong result>"')
  if (!flags.repro) missing.push('--repro "<the command you actually ran to reproduce it>"')
  if (!flags.evidence) missing.push('--evidence "<what that command printed — paste, do not paraphrase>"')
  if (!flags.fix) missing.push('--fix "<smallest change + the rung that proves it>"')
  if (missing.length) {
    console.error(`${RED}✗${OFF} unverified findings are not filed here. Missing:`)
    for (const m of missing) console.error(`   ${m}`)
    console.error('')
    console.error('   If you have not reproduced it, you do not know it is a defect.')
    console.error('   Say "I suspect X but did not verify it" and move on — do not file.')
    process.exit(1)
  }
  if (!TYPES.includes(flags.type)) die(`--type must be one of: ${TYPES.join(', ')}`)
  if (!AREAS.includes(flags.area)) die(`--area must be one of: ${AREAS.join(', ')}`)
  const priority = flags.priority || 'P2'
  if (!PRIORITIES[priority]) die(`--priority must be one of: ${Object.keys(PRIORITIES).join(', ')}`)

  const scope = loadScope()
  const foundWhile = scope ? scope.intent : '(no scope declared)'
  const title = `${flags.type}: ${defect.replace(/\.$/, '')}`
  const body = [
    '### Location', '', `\`${location}\``, '',
    '### The defect', '', defect, '',
    '### Failure scenario', '', flags.failure, '',
    '### Reproduced with', '', '```sh', flags.repro, '```', '',
    '### Output', '', '```', flags.evidence, '```', '',
    '### Suggested fix', '', flags.fix, '',
    '### Found while', '', foundWhile, '',
    '---', '',
    'Filed by `bin/harness note`. Reproduced before filing; left unfixed deliberately',
    'because it was outside the declared scope.',
    ''
  ].join('\n')

  const labels = ['agent-finding', 'status: needs-triage', `type: ${flags.type}`,
    `area: ${flags.area}`, PRIORITIES[priority]]

  const remote = tryGit(['remote', 'get-url', 'origin'])
  const hasGh = (() => { try { execFileSync('gh', ['--version'], { stdio: 'ignore' }); return true } catch { return false } })()

  if (remote && hasGh) {
    try {
      const url = execFileSync('gh', ['issue', 'create', '--title', title, '--body', body,
        ...labels.flatMap((l) => ['--label', l])],
      { cwd: ROOT, encoding: 'utf8' }).trim()
      ok(`filed ${url}`)
      info('   now go back to what you were doing.')
      return
    } catch (e) {
      console.error(`${YELLOW}!${OFF} gh could not file the issue (${String(e.message).split('\n')[0]}) — falling back to FINDINGS.md`)
      if (/label/i.test(String(e.message))) info('   run `bin/harness labels` once to create the canonical label set')
    }
  } else {
    info(remote ? 'gh is not installed — writing to FINDINGS.md' : 'no git remote — writing to FINDINGS.md')
  }

  const entry = [`## ${title}`, '', `*labels:* ${labels.join(', ')}`, '', body, ''].join('\n')
  const header = '# Findings\n\nThings noticed while doing something else, deliberately left unfixed.\nMove each one to a GitHub issue with `bin/harness labels && bin/harness note …` once a remote exists.\n'
  const current = exists('FINDINGS.md') ? read('FINDINGS.md') : header
  fs.writeFileSync(p('FINDINGS.md'), current.trimEnd() + '\n\n' + entry)
  ok(`appended to FINDINGS.md: ${title}`)
  info('   now go back to what you were doing.')
}

/* ----------------------------------------------------------------- labels */

function cmdLabels () {
  const remote = tryGit(['remote', 'get-url', 'origin'])
  if (!remote) die('no git remote — labels live on GitHub, so add one first')
  const { labels } = JSON.parse(read('harness/github/labels.json'))
  let created = 0, updated = 0
  for (const l of labels) {
    try {
      execFileSync('gh', ['label', 'create', l.name, '--color', l.color, '--description', l.description],
        { cwd: ROOT, stdio: 'ignore' })
      created++
    } catch {
      try {
        execFileSync('gh', ['label', 'edit', l.name, '--color', l.color, '--description', l.description],
          { cwd: ROOT, stdio: 'ignore' })
        updated++
      } catch (e) { console.error(`${YELLOW}!${OFF} could not set ${l.name}`) }
    }
  }
  ok(`labels: ${created} created, ${updated} updated (${labels.length} canonical)`)
}

/* ------------------------------------------------------------ install-hooks */

function cmdInstallHooks () {
  const dir = tryGit(['rev-parse', '--git-path', 'hooks'])
  if (!dir) die('not a git repository')
  const hooks = path.isAbsolute(dir) ? dir : p(dir)
  fs.mkdirSync(hooks, { recursive: true })

  // Git hooks rather than editor hooks, deliberately. The Stop and PreToolUse
  // gates only exist inside one tool; git runs for every tool, every person and
  // every script, so this is the one enforcement everything shares.
  const written = []

  // The hooks directory is shared by every worktree of the repository, so the
  // hooks resolve the harness in the checkout being committed in, not in the
  // one that installed them — which may be a worktree deleted since. A
  // checkout without the harness (a branch from before it) is let through.
  const locate = (file) => `root=$(git rev-parse --show-toplevel) || exit 1
[ -f "$root/${file}" ] || exit 0`

  fs.writeFileSync(path.join(hooks, 'commit-msg'), `#!/bin/sh
# GENERATED by \`bin/harness install-hooks\` — the commit convention gate.
${locate('bin/harness')}
exec node "$root/bin/harness" check-commit-msg "$1"
`, { mode: 0o755 })
  written.push('commit-msg')

  fs.writeFileSync(path.join(hooks, 'pre-commit'), `#!/bin/sh
# GENERATED by \`bin/harness install-hooks\`.
#
# The cheap half of the ladder, on every commit, in every tool. It runs in a few
# seconds and covers what goes wrong most often: a stale generated file, a
# string in one language only, a hex colour, a type error, a diff that spilled
# outside its scope.
#
# It deliberately does not build: a pre-commit hook that takes a minute is one
# people learn to skip, and skipping it is a single flag away.
${locate('verify/quick.sh')}
exec zsh "$root/verify/quick.sh"
`, { mode: 0o755 })
  written.push('pre-commit')

  ok(`installed ${written.join(' and ')} hooks in ${hooks}`)
  info('these run for every tool and every person, not only inside one editor')
}

function cmdCheckCommitMsg (argv) {
  const file = argv[0]
  if (!file) die('usage: harness check-commit-msg <file>')
  const lines = fs.readFileSync(file, 'utf8').split('\n').filter((l) => !l.startsWith('#'))
  const subject = (lines[0] || '').trim()
  const rest = lines.join('\n')

  const trailer = /^\s*(co-authored-by|generated with|assisted-by)\s*:/im.exec(rest)
  if (trailer) {
    console.error(`${RED}✗${OFF} commit rejected: no co-author or attribution trailers.`)
    console.error(`   found: ${trailer[0].trim()}`)
    console.error('   Commits here are authored by the local git user and nobody else.')
    process.exit(1)
  }

  const re = new RegExp(`^(${TYPES.join('|')})(\\([a-z0-9._/-]+\\))?: \\S+ .+[^.]$`, 'u')
  if (!re.test(subject)) {
    console.error(`${RED}✗${OFF} commit rejected: subject must be \`<type>(<scope>): <emoji> <subject>\``)
    console.error(`   got: ${subject || '(empty)'}`)
    console.error(`   types: ${TYPES.join(', ')}`)
    console.error('   example: feat(tools): ✨ add the xml formatter')
    process.exit(1)
  }
  if (subject.length > 72) {
    console.error(`${RED}✗${OFF} commit rejected: subject is ${subject.length} characters, keep it under 72`)
    process.exit(1)
  }
}

/* ---------------------------------------------------------------- doctor */

function cmdDoctor () {
  const checks = [
    ['node', ['--version'], true, 'required — runs this tool and the site (Node 24+, see .node-version)'],
    ['npm', ['--version'], true, 'required — installs the dependencies'],
    ['git', ['--version'], true, 'required'],
    ['zsh', ['--version'], true, 'required — the verify/ rungs are zsh scripts'],
    ['gh', ['--version'], false, 'optional — findings become GitHub issues; without it they go to FINDINGS.md']
  ]
  let missingRequired = 0
  for (const [bin, args, required, note] of checks) {
    let version = null
    try { version = execFileSync(bin, args, { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }).split('\n')[0].trim() } catch {}
    if (version) console.log(`${GREEN}✓${OFF} ${bin.padEnd(13)} ${DIM}${version}${OFF}`)
    else {
      console.log(`${required ? RED + '✗' : YELLOW + '○'}${OFF} ${bin.padEnd(13)} ${DIM}${note}${OFF}`)
      if (required) missingRequired++
    }
  }

  const major = Number(process.versions.node.split('.')[0])
  if (major < Number(project.node)) {
    console.log(`${RED}✗${OFF} ${'node version'.padEnd(13)} ${DIM}${process.versions.node} — CI runs ${project.node}; use ${project.node}+${OFF}`)
    missingRequired++
  }

  const installed = exists('node_modules/.bin/next')
  console.log(installed
    ? `${GREEN}✓${OFF} ${'node_modules'.padEnd(13)} ${DIM}installed${OFF}`
    : `${RED}✗${OFF} ${'node_modules'.padEnd(13)} ${DIM}npm install${OFF}`)
  if (!installed) missingRequired++

  // The smoke rung drives Chromium through playwright; its browser is a
  // separate download from the npm package.
  let chromium = null
  try {
    chromium = execFileSync('node', ['-e', "process.stdout.write(require('playwright').chromium.executablePath())"],
      { cwd: ROOT, encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }).trim()
  } catch {}
  console.log(chromium && fs.existsSync(chromium)
    ? `${GREEN}✓${OFF} ${'chromium'.padEnd(13)} ${DIM}playwright browser present${OFF}`
    : `${YELLOW}○${OFF} ${'chromium'.padEnd(13)} ${DIM}optional — verify/smoke.sh needs it: npx playwright install chromium${OFF}`)

  const hooks = tryGit(['rev-parse', '--git-path', 'hooks'])
  const hooksDir = hooks && (path.isAbsolute(hooks) ? hooks : p(hooks))
  const hooked = hooksDir && fs.existsSync(path.join(hooksDir, 'commit-msg')) && fs.existsSync(path.join(hooksDir, 'pre-commit'))
  console.log(hooked
    ? `${GREEN}✓${OFF} ${'git hooks'.padEnd(13)} ${DIM}commit-msg and pre-commit installed${OFF}`
    : `${YELLOW}○${OFF} ${'git hooks'.padEnd(13)} ${DIM}bin/harness install-hooks${OFF}`)

  const scope = loadScope()
  console.log('')
  console.log(scope ? `${YELLOW}●${OFF} scope declared: ${scope.intent}` : `${DIM}○ no scope declared${OFF}`)
  if (missingRequired) process.exit(1)
}

/* -------------------------------------------------------------------- cli */

const USAGE = `harness — the agent harness for ${project.displayName}

  sync [--check]        generate every vendor target from harness/ (--check fails on drift)
  scope "<intent>" <path>...   declare what this task may touch
  scope --show          print the current scope
  note "<defect>" <file>:<line> --type <t> --area <a> --failure … --repro … --evidence … --fix …
                        file a REPRODUCED finding as a GitHub issue and keep working
  done                  clear the declared scope
  labels                create or update the canonical labels on the remote
  install-hooks         install the commit-msg convention gate and the pre-commit quick rungs
  doctor                check the local toolchain
`

const [cmd, ...argv] = process.argv.slice(2)
const commands = {
  sync: cmdSync,
  scope: cmdScope,
  done: cmdDone,
  note: cmdNote,
  labels: cmdLabels,
  'install-hooks': cmdInstallHooks,
  'check-commit-msg': cmdCheckCommitMsg,
  'post-edit': cmdPostEdit,
  'pre-edit': cmdPreEdit,
  'pre-compact': cmdPreCompact,
  'session-end': cmdSessionEnd,
  'session-start': cmdSessionStart,
  'pre-bash': cmdPreBash,
  stop: cmdStop,
  'stamp-verify': cmdStampVerify,
  // The generated-file prefixes, one per line — so verify/scope.sh reads this
  // list instead of hand-copying it and silently drifting from inScope().
  'generated-prefixes': () => { console.log(GENERATED_PREFIXES.join('\n')) },
  doctor: cmdDoctor
}
if (!cmd || cmd === '--help' || cmd === '-h') { console.log(USAGE); process.exit(0) }
if (!commands[cmd]) { console.error(USAGE); die(`unknown command: ${cmd}`) }
commands[cmd](argv)
